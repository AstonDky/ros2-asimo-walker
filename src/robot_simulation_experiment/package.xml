<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_simulation_experiment</name>
  <version>0.1.0</version>
  <description>ROS 2 locomotion and keyboard teleoperation for a CoppeliaSim Asti biped.</description>
  <maintainer email="2541161397@qq.com">Keyan Dong (AstonDky)</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/AstonDky/ros2-asimo-walker</url>
  <url type="bugtracker">https://github.com/AstonDky/ros2-asimo-walker/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
